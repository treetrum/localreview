{
  "name": "localreview",
  "version": "0.1.0",
  "private": true,
  "description": "Review a local git diff in the browser and copy comments as Markdown for an AI coding agent",
  "bin": {
    "localreview": "src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "vite build",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test:server && bun run test:web",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test:server": "bun test ./src",
    "test:web": "vitest run",
    "test:e2e": "vite build && playwright test",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.4.4"
}
